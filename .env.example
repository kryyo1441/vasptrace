# Copy to .env and fill in.

DATABASE_URL="file:./dev.db"

# Required — signs session cookies (lib/auth.ts). The app fails to boot
# without it, on purpose: signing a session with `undefined` would silently
# make every session forgeable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Live Ethereum tracer (Etherscan API) — see lib/tracers/ethereum.ts
ETHERSCAN_API_KEY=""

# Optional — Tron tracer works keyless at demo volume; set this if Tronscan
# starts rate-limiting. See lib/tronscan.ts.
TRONSCAN_API_KEY=""

# Optional — n8n orchestration-visibility layer (SIH plan item 6). Leave
# unset to run without n8n; the trace/Sahyog routes work standalone either
# way. Set these to the Webhook node URLs from the two workflows in
# n8n/workflows/ once imported into a running n8n instance (see
# docker-compose.yml and docs/ARCHITECTURE.md).
N8N_TRACE_WEBHOOK_URL=""
N8N_SAHYOG_WEBHOOK_URL=""

# Optional — LLM-drafted case narrative (app/api/cases/[id]/narrative). Leave
# unset to disable the feature entirely; every other route works without it.
# Drafts prose only, never the score/risk/recommendation. Get a key at
# console.anthropic.com.
ANTHROPIC_API_KEY=""

# Optional — bearer token for POST /api/watches/check-all, the address-
# watchlist bulk-check endpoint an external scheduler (cron, n8n) calls.
# Leave unset to disable that route (401 on every call); the session-gated
# per-watch "Check now" button in the UI doesn't need it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WATCH_CRON_TOKEN=""
